# El repo funciona con una lista de permitidos: se ignora todo y aquí se enumera lo
# que sí entra. Un archivo nuevo queda fuera hasta que se agrega explícitamente.
*

# Raíz
!/.gitignore
!/README.md
!/nbsetup.py

# La tesis en LaTeX. Las imágenes de tesis/Imagenes/ no entran: se regeneran con
# scripts/figuras/. Los auxiliares de compilación (.aux, .log, .toc…) tampoco.
!/tesis/
!/tesis/**/
!/tesis/**/*.tex
!/tesis/**/*.bib
!/tesis/**/*.sty
!/tesis/**/*.cls
!/tesis/**/*.bst

# Todo el código: el pipeline, los notebooks del análisis, las figuras, el visor y
# el análisis de septiembre (historico/). Las vistas previas en PNG de las figuras no
# entran.
!/scripts/
!/scripts/**/
!/scripts/**/*.py
!/scripts/**/*.ipynb
!/scripts/**/*.md
!/scripts/visor/static/*.html
!/scripts/visor/static/*.css
!/scripts/visor/static/*.js

# La skill de las figuras: estilo, fuentes, convenciones y ejemplos. Los scripts de
# scripts/figuras/ importan el estilo de aquí.
!/.claude/
!/.claude/skills/
!/.claude/skills/figuras-tesis/
!/.claude/skills/figuras-tesis/**/
!/.claude/skills/figuras-tesis/**/*.md
!/.claude/skills/figuras-tesis/**/*.py
!/.claude/skills/figuras-tesis/**/*.mplstyle
!/.claude/skills/figuras-tesis/**/*.otf
!/.claude/skills/figuras-tesis/**/*.png

# Insumos limpios, para reconstruir el análisis sin repetir la limpieza.
!/data/
!/data/classified-incidents.parquet
!/data/vialidades.json
!/data/afluencia-metro-diaria.parquet
!/data/volumen-total-mensual.parquet
# El resultado del bootstrap: 75 minutos de cómputo que no hace falta repetir.
!/data/bootstrap-coeficientes.parquet
!/data/fotocivicas-ubicacion-puntos/
!/data/fotocivicas-ubicacion-puntos/fotocivicas-ubicacion-puntos.dbf
!/data/fotocivicas-ubicacion-puntos/fotocivicas-ubicacion-puntos.prj
!/data/fotocivicas-ubicacion-puntos/fotocivicas-ubicacion-puntos.shp
!/data/fotocivicas-ubicacion-puntos/fotocivicas-ubicacion-puntos.shx
# Metro: estaciones y líneas, cada shapefile con sus archivos hermanos. Sin el .prj
# se pierde el CRS, y las dos capas vienen en sistemas distintos.
!/data/stcmetro_shp/
!/data/stcmetro_shp/estaciones/
!/data/stcmetro_shp/estaciones/*
!/data/stcmetro_shp/lineas/
!/data/stcmetro_shp/lineas/*
# Contorno de la ciudad para los hexágonos del apéndice B. El conteo de Google Places
# (data/raw/businesses-cdmx.json) se queda fuera por los términos de uso de Google.
!/data/localidadurbana/
!/data/localidadurbana/*

# Notas de trabajo: revisión del asesor, pendientes y apuntes. Las fotos no entran.
!/notas/
!/notas/*.md

# Lo que se genera dentro de las carpetas permitidas.
**/.ipynb_checkpoints/
**/__pycache__/
**/.venv/
**/venv/
**/node_modules/
