# Ignore everything except thesis sources, analysis scripts, and selected inputs.
*
!.gitignore
!/README.md
!/nbsetup.py
!/notas/
!/notas/Errores Cometidos.md
!/notas/Conclusiones.md
!/figures/
!/figures/efecto-por-radio.svg
!/figures/efecto-por-radio-*.svg
!/figures/brecha-posterior.svg
!/figures/brecha-posterior-*.svg
!/figures/componente-tratado-100-200-300.svg
!/figures/conclusion-*.svg
# Script de las figuras de la introducción: sus datos no tienen otra copia.
!/figures/scripts/
!/figures/scripts/intro_figures.py
# Figuras del capítulo 3 y el estilo común de las figuras de la tesis.
!/figures/scripts/capitulo3_figures.py
!/figures/scripts/estilo_tesis.py
!/figures/tesis.mplstyle
!/figures/fonts/
!/figures/fonts/*.otf
# Figuras del capítulo 4 (resultados), aún sin incluir en 4.Results.tex.
!/figures/scripts/capitulo4_figures.py

!/causal-effects-speed-cameras/
!/causal-effects-speed-cameras/**/
!/causal-effects-speed-cameras/**/*.tex
!/causal-effects-speed-cameras/**/*.bib
!/causal-effects-speed-cameras/**/*.sty
!/causal-effects-speed-cameras/**/*.cls
!/causal-effects-speed-cameras/**/*.bst
!/causal-effects-speed-cameras/**/*.py

!/scripts/
!/scripts/**/
!/scripts/**/*.py
!/scripts/**/*.ipynb
!/scripts/**/*.md
!/scripts/**/*.R
!/scripts/**/*.r
!/scripts/**/*.Rmd
!/scripts/**/*.do
!/scripts/**/*.sh

# Clean inputs for rebuilding the analysis without repeating data cleaning.
!/data/
!/data/classified-incidents.parquet
!/data/vialidades.json
!/data/afluencia-metro-diaria.parquet
!/data/volumen-total-mensual.parquet
# Resultado del bootstrap: 75 minutos de cómputo que no hace falta repetir.
!/data/bootstrap-coeficientes.parquet
!/data/fotocivicas-ubicacion-puntos/
!/data/fotocivicas-ubicacion-puntos/fotocivicas-ubicacion-puntos.dbf
!/data/fotocivicas-ubicacion-puntos/fotocivicas-ubicacion-puntos.prj
!/data/fotocivicas-ubicacion-puntos/fotocivicas-ubicacion-puntos.shp
!/data/fotocivicas-ubicacion-puntos/fotocivicas-ubicacion-puntos.shx

# Metro: estaciones y líneas del STC, cada shapefile con sus archivos hermanos.
# Sin el .prj se pierde el CRS, y las dos capas vienen en sistemas distintos.
!/data/stcmetro_shp/
!/data/stcmetro_shp/estaciones/
!/data/stcmetro_shp/estaciones/*
!/data/stcmetro_shp/lineas/
!/data/stcmetro_shp/lineas/*

# Generated files, notebook checkpoints, and local environments.
**/.ipynb_checkpoints/
**/__pycache__/
**/.venv/
**/venv/
**/node_modules/
/.git-backups/
